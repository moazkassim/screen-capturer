{
  "name": "screen-capturer",
  "version": "1.0.0",
  "description": "A screen capturer app using Electron",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/main/main.js",
  "scripts": {
    "start": "nodemon --ext js,css,html --exec electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.ae.screen_capturer",
    "productName": "screen-capturer",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "icon": "src/assets/camera.ico"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  }
}
